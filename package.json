{
  "name": "muse-local-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "migrate": "tsx src/cli.ts migrate",
    "cli": "tsx src/cli.ts",
    "seed": "tsx src/cli.ts seed",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "web-push": "3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/web-push": "3.6.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}

# Copy to .env.development.local for local work.
DATABASE_URL=postgres://muse:CHANGE_ME@127.0.0.1:55432/muse_bridge
# DEV quick login: only honoured by `next dev` on a loopback host. Production builds ignore it.
ENABLE_DEV_QUICK_LOGIN=false
DEV_QUICK_LOGIN_USERS=a:Test User A:<user uuid>,b:Test User B:<user uuid>
# Admin allowlist (server-side, comma separated QLead user ids). Only these users can open /admin and /api/admin/*.
QLEAD_ADMIN_USER_IDS=
# Landing "Thử tìm khách hàng" (server-side, comma separated QLead user ids): ONLY the search profiles of these
# showcase accounts feed the public landing search. Customers' leads are never used. Empty = the landing search
# answers "chưa có lead phù hợp" honestly. See docs/landing-real-leads-20261108/REPORT.md.
QLEAD_LANDING_CATALOG_USER_IDS=
# Public HTTPS base URL that Muse workers call (used in generated Muse prompts), e.g. https://your-tunnel.example
QLEAD_WORKER_PUBLIC_URL=
